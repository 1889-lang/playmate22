.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #FFFFFF;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #EAEBE6;
  z-index: 9999;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.tab-text {
  /* 在这里随意调整字体大小和字重 */
  font-size: 28rpx;
  font-weight: 500;
  color: #85877B;
}

.tab-bar-item.active .tab-text {
  color: #2E5A44;
  font-weight: 700;
}
