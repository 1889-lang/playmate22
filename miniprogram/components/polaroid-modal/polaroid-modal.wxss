.polaroid-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(30, 27, 25, 0.75);
  backdrop-filter: blur(8px);
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.polaroid-wrapper {
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-top-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.top-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
}

.close-circle-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.polaroid-swiper {
  width: 100%;
  height: 720rpx;
}

.swiper-item-box {
  display: flex;
  justify-content: center;
  align-items: center;
}

.polaroid-card {
  width: 540rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 24rpx 36rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-date {
  font-size: 22rpx;
  color: #85877B;
  margin-bottom: 16rpx;
}

.polaroid-photo-frame {
  width: 100%;
  height: 440rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #FAF9F2;
  border: 1rpx solid #EDF4E9;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.card-caption {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.act-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #292524;
}

.mood-stamp-badge {
  background-color: #FEF3E2;
  border: 1rpx solid #FDBA74;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #EA580C;
  font-weight: 600;
}

.page-indicator {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  font-weight: 600;
}

.action-footer {
  margin-top: 32rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.share-btn {
  width: 440rpx !important;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #559E75 !important;
  color: #FFFFFF !important;
  border-radius: 44rpx;
  font-size: 28rpx !important;
  font-weight: 700;
}

.text-close-link {
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
  padding: 8rpx 20rpx;
}
