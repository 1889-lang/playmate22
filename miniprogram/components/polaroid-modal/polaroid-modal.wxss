.polaroid-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(30, 27, 25, 0.65);
  backdrop-filter: blur(6px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-width: 620rpx;
  background-color: #FAF9F2;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.22);
  display: flex;
  flex-direction: column;
}

.modal-top-banner {
  background-color: #E8F2EC;
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.banner-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.banner-icon {
  font-size: 32rpx;
}

.banner-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
}

.close-icon-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.8);
  color: #85877B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.polaroid-white-frame {
  margin: 28rpx 32rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 24rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.polaroid-date {
  font-size: 22rpx;
  color: #85877B;
  margin-bottom: 16rpx;
}

.polaroid-photo-box {
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background-color: #FAF9F2;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.camera-floating-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: rgba(46, 90, 68, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  font-size: 26rpx;
}

.polaroid-caption {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.act-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #292524;
}

.mood-time-badge {
  background-color: #E8F2EC;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #2E5A44;
  font-weight: 600;
}

.mood-selection-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 10rpx 32rpx 24rpx;
}

.mood-chip {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #EDF4E9;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #45483F;
}

.mood-chip.active {
  background-color: #E8F2EC;
  border-color: #559E75;
  color: #2E5A44;
  font-weight: 700;
}

.bottom-actions {
  padding: 0 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.primary-share-btn {
  width: 100% !important;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #2E8B57 !important;
  color: #FFFFFF !important;
  border-radius: 45rpx;
  font-size: 28rpx !important;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(46, 139, 87, 0.3);
  border: none;
}

.close-text-btn {
  font-size: 24rpx;
  color: #85877B;
  padding: 6rpx 20rpx;
}
