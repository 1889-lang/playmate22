.polaroid-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(30, 27, 25, 0.65);
  backdrop-filter: blur(6px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 40rpx;
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-width: 580rpx;
  background-color: #FAF9F2;
  border-radius: 36rpx;
  padding: 28rpx 28rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.12);
}

.modal-top-banner {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.banner-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.banner-icon {
  font-size: 32rpx;
}

.banner-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3748;
}

.close-icon-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  background: #E2E8F0;
  color: #718096;
  font-size: 24rpx;
}

/* 拍立得相框 */
.polaroid-white-frame {
  width: 100%;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx 16rpx 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.polaroid-date {
  font-size: 20rpx;
  color: #A0AEC0;
  margin-bottom: 10rpx;
}

.polaroid-photo-box {
  width: 100%;
  height: 380rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  background: #F0EDE5;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.camera-floating-btn {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  font-size: 24rpx;
}

.polaroid-caption {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 14rpx;
}

.act-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3748;
  text-align: center;
}

.mood-time-badge {
  font-size: 22rpx;
  color: #4D7C5F;
  background: #EAF3EC;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  margin-top: 8rpx;
}

/* 心情标签行 */
.mood-selection-row {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0 18rpx;
}

.mood-chip {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  font-size: 22rpx;
  color: #4A5568;
}

.mood-chip.active {
  background: #EAF3EC;
  border-color: #2E5A44;
  color: #2E5A44;
  font-weight: 600;
}

/* 精致雅致的保存按钮 */
.bottom-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.primary-save-btn {
  width: 280rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  padding: 0 !important;
  background: #2E5A44 !important;
  color: #FFFFFF !important;
  font-size: 26rpx !important;
  font-weight: 500 !important;
  border-radius: 36rpx !important;
  margin: 0 0 12rpx 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none !important;
}

.close-text-btn {
  font-size: 22rpx;
  color: #A0AEC0;
  padding: 6rpx;
}
