<view wx:if="{{visible}}" class="polaroid-overlay" catchtouchmove="preventProp" bindtap="handleClose">
  <view class="modal-card" catchtap="preventProp">
    <view class="modal-top-banner">
      <view class="banner-title-wrap">
        <text class="banner-icon">🎉</text>
        <text class="banner-text">太棒了！完成了本次陪伴</text>
      </view>
      <view class="close-icon-btn" bindtap="handleClose">✕</view>
    </view>

    <view class="polaroid-white-frame">
      <text class="polaroid-date">{{todayDate}}</text>
      <view class="polaroid-photo-box" bindtap="handleChoosePhoto">
        <image class="photo-img" src="{{customPhoto || record.coverImage}}" mode="aspectFill" />
        <view class="camera-floating-btn">
          <text class="camera-icon">📷</text>
        </view>
      </view>

      <view class="polaroid-caption">
        <text class="act-title">{{record.activityTitle}}</text>
        <view class="mood-time-badge">
          <text>{{selectedMood.emoji}} {{selectedMood.text}} · 陪伴 {{durationMinutes}} 分钟</text>
        </view>
      </view>
    </view>

    <view class="mood-selection-row">
      <block wx:for="{{moodOptions}}" wx:key="text">
        <view 
          class="mood-chip {{selectedMood.text === item.text ? 'active' : ''}}" 
          bindtap="handleSelectMood" 
          data-mood="{{item}}"
        >
          <text>{{item.emoji}} {{item.text}}</text>
        </view>
      </block>
    </view>

    <view class="bottom-actions">
      <button class="primary-save-btn" bindtap="handleSavePoster">
        <text>保存</text>
      </button>
      <view class="close-text-btn" bindtap="handleClose">
        <text>收入成长足迹并关闭</text>
      </view>
    </view>
  </view>

  <!-- 离屏海报生成画布（放在最外层根节点底部，绝不打乱布局） -->
  <canvas 
    id="posterCanvas" 
    type="2d" 
    style="position: fixed; left: -9999px; top: -9999px; width: 320px; height: 480px;"
  ></canvas>
</view>
