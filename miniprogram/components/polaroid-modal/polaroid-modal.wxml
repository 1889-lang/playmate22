<view wx:if="{{visible}}" class="polaroid-overlay" catchtouchmove="preventProp" bindtap="handleClose">
  <view class="polaroid-wrapper" catchtap="preventProp">
    <view class="modal-top-bar">
      <text class="top-title">陪伴手账已生成</text>
      <view class="close-circle-btn" bindtap="handleClose">✕</view>
    </view>

    <swiper class="polaroid-swiper" current="{{currentIndex}}" bindchange="onSwiperChange">
      <block wx:for="{{records}}" wx:key="id">
        <swiper-item class="swiper-item-box">
          <view class="polaroid-card">
            <text class="card-date">{{item.date}}</text>
            <view class="polaroid-photo-frame">
              <image class="photo-img" src="{{item.coverImage}}" mode="aspectFill" />
            </view>
            <view class="card-caption">
              <text class="act-name">{{item.activityTitle}}</text>
              <view class="mood-stamp-badge">
                <text>{{item.mood || '好奇探索 · 幸福 🌟'}}</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>

    <view class="page-indicator" wx:if="{{records.length > 1}}">
      <text>{{currentIndex + 1}} / {{records.length}}</text>
    </view>

    <view class="action-footer">
      <button class="share-btn" open-type="share">
        <text>📤 分享给家人</text>
      </button>
      <view class="text-close-link" bindtap="handleClose">
        <text>完成记录</text>
      </view>
    </view>
  </view>
</view>
