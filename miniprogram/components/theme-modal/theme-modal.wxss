.theme-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  z-index: 990;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease-in-out;
}

.theme-modal-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.theme-modal-card {
  width: 100%;
  max-height: 85vh;
  background: #FAF9F2;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.theme-modal-mask.visible .theme-modal-card {
  transform: translateY(0);
}

.theme-header {
  padding: 32rpx 36rpx 24rpx;
  background: #EDF4E9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(98, 173, 120, 0.2);
}

.theme-title-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  padding-right: 20rpx;
}

.theme-age-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #3F8054;
  background: #FFFFFF;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(98, 173, 120, 0.3);
  flex-shrink: 0;
}

.theme-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #33392E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #555A4E;
  flex-shrink: 0;
}

.theme-body {
  padding: 28rpx 32rpx 60rpx;
  box-sizing: border-box;
  max-height: calc(85vh - 120rpx);
}

.goal-box {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #EDF4E9;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.goal-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #3F8054;
  margin-bottom: 8rpx;
}

.goal-desc {
  font-size: 26rpx;
  color: #4A5568;
  line-height: 1.5;
}

.intro-box {
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.intro-text {
  font-size: 26rpx;
  color: #718096;
  line-height: 1.6;
}

.activities-section {
  margin-top: 12rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3748;
}

.count-tag {
  font-size: 22rpx;
  color: #3F8054;
  background: #EDF4E9;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.activities-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.theme-act-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #F0EFEA;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  align-items: center;
}

.theme-act-card:active {
  transform: scale(0.99);
  background: #FDFCF7;
}

.act-cover {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  background: #F5F4EE;
  flex-shrink: 0;
}

.act-content {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 150rpx;
  padding: 4rpx 0;
}

.act-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.act-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3748;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.act-cat {
  font-size: 20rpx;
  color: #4D7C5F;
  background: #EAF3EC;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.act-sub {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.act-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.role-tag {
  font-size: 22rpx;
  color: #B86834;
  background: rgba(232, 181, 141, 0.2);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.act-duration {
  font-size: 22rpx;
  color: #A0AEC0;
}
