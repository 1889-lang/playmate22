<view wx:if="{{visible}}" class="modal-backdrop" catchtouchmove="preventProp" bindtap="handleClose">
  <view class="journal-card" catchtap="preventProp">
    <view class="card-header">
      <view>
        <view class="title-row">
          <text class="title-main">记录这刻美好</text>
          <text class="badge-tag">手账打卡</text>
        </view>
        <text class="subtitle">记录活动点滴，沉淀宝宝每一步成长</text>
      </view>
      <view class="close-icon" bindtap="handleClose">✕</view>
    </view>

    <!-- 照片上传与预览 -->
    <view class="photo-zone" bindtap="handleChoosePhoto">
      <view class="polaroid-preview-frame">
        <image class="preview-img" src="{{photoUrl || activity.coverImage}}" mode="aspectFill" />
        <view class="photo-tip-overlay">
          <text class="camera-icon">📷</text>
          <text class="tip-text">{{photoUrl ? '点击更换相片' : '点击上传今天互动的抓拍'}}</text>
        </view>
      </view>
    </view>

    <!-- 心情标签选择 -->
    <view class="field-section">
      <text class="section-label">宝宝当下的状态：</text>
      <view class="mood-grid">
        <block wx:for="{{moods}}" wx:key="tag">
          <view 
            class="mood-btn {{selectedMood === item.tag ? 'active' : ''}}" 
            catchtap="selectMood" 
            data-mood="{{item.tag}}"
          >
            <text class="mood-emoji">{{item.emoji}}</text>
            <text class="mood-text">{{item.text}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 随手记心得 -->
    <view class="field-section">
      <text class="section-label">成长微日记（选填）：</text>
      <input 
        class="journal-input" 
        placeholder="记下宝宝今天的小表情、新动作…" 
        placeholder-class="input-placeholder"
        value="{{notes}}" 
        bindinput="onInputNotes"
        maxlength="60"
      />
    </view>

    <view class="card-footer">
      <view class="confirm-generate-btn" catchtap="handleGenerate">
        <text>生成拍立得手账 ✨</text>
      </view>
    </view>
  </view>
</view>
