.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(30, 27, 25, 0.65);
  backdrop-filter: blur(6px);
  z-index: 10001;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.journal-card {
  width: 100%;
  max-width: 620rpx;
  background-color: #FAF9F2;
  border-radius: 40rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.22);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-main {
  font-size: 32rpx;
  font-weight: 800;
  color: #292524;
}

.badge-tag {
  background-color: #EDF4E9;
  color: #3F8054;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.subtitle {
  font-size: 22rpx;
  color: #85877B;
  margin-top: 6rpx;
  display: block;
}

.close-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #F0EEE4;
  color: #85877B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.photo-zone {
  margin-bottom: 24rpx;
}

.polaroid-preview-frame {
  width: 100%;
  height: 300rpx;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  background-color: #FFFFFF;
  border: 2rpx dashed #C8DAC9;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.photo-tip-overlay {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background-color: rgba(30, 27, 25, 0.7);
  color: #FFFFFF;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.camera-icon {
  font-size: 22rpx;
}

.tip-text {
  font-size: 20rpx;
}

.field-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #45483F;
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.mood-btn {
  background-color: #FFFFFF;
  border: 1rpx solid #EDF4E9;
  border-radius: 22rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mood-btn.active {
  background-color: #FEF3E2;
  border-color: #FDBA74;
}

.mood-emoji {
  font-size: 28rpx;
}

.mood-text {
  font-size: 22rpx;
  color: #45483F;
  font-weight: 600;
}

.mood-btn.active .mood-text {
  color: #EA580C;
}

.journal-input {
  width: 100%;
  height: 72rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid #EDF4E9;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #292524;
}

.input-placeholder {
  color: #A8A29E;
  font-size: 22rpx;
}

.card-footer {
  margin-top: 12rpx;
}

.confirm-generate-btn {
  width: 100%;
  height: 88rpx;
  background-color: #559E75;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(85, 158, 117, 0.28);
}

.confirm-generate-btn:active {
  background-color: #3F8054;
}
