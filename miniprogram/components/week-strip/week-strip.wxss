/* miniprogram/components/week-strip/week-strip.wxss */
.week-strip-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #EDF4E9;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 24rpx;
}

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.title-group {
  display: flex;
  flex-direction: column;
}

.month-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #292524;
}

.subtitle {
  font-size: 22rpx;
  color: #858078;
  margin-top: 2rpx;
}

.nav-buttons {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: #F5F5F4;
  color: #78716C;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.today-btn {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background-color: #ECFDF5;
  color: #047857;
  font-size: 22rpx;
  font-weight: 600;
}

.grid-7 {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  width: 100%;
}

.day-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.day-name {
  font-size: 22rpx;
  color: #A8A29E;
  margin-bottom: 8rpx;
}

.day-num-box {
  width: 72rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.active-box {
  background-color: #2E5A44;
  color: #FFFFFF !important;
}

.active-box .day-num {
  color: #FFFFFF !important;
}

.day-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #44403C;
}

.today-text {
  color: #047857;
  font-weight: 800;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-top: 6rpx;
}

.dot-active {
  background-color: #10B981;
}

.active-box .dot-active {
  background-color: #A7F3D0;
}

.dot-hidden {
  opacity: 0;
}
