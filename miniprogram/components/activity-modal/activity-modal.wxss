.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(30, 27, 25, 0.65);
  backdrop-filter: blur(6px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.sheet-container {
  width: 100%;
  max-width: 620rpx;
  background-color: #FAF9F2;
  border-radius: 40rpx;
  padding: 36rpx 32rpx 40rpx;
  box-sizing: border-box;
  max-height: 84vh;
  overflow-y: auto;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.22);
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.activity-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #292524;
}

.category-pill {
  font-size: 20rpx;
  color: #2E5A44;
  background-color: #E8F2EC;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.round-icon-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: #F0EEE4;
  color: #85877B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.illustration-frame {
  width: 100%;
  height: 320rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background-color: #FFFFFF;
  margin-bottom: 24rpx;
  border: 1rpx solid #EDF4E9;
}

.cover-art {
  width: 100%;
  height: 100%;
}

.steps-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-badge {
  font-size: 24rpx;
  font-weight: 700;
  color: #3F8054;
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.step-number {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #559E75;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.step-text-wrap {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.5;
  color: #45483F;
}

.step-bold {
  font-weight: 700;
  color: #292524;
}

.tips-box {
  background-color: #FFFFFF;
  border: 1rpx solid #EDF4E9;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.tips-heading {
  font-size: 22rpx;
  font-weight: 700;
  color: #3F8054;
  display: block;
  margin-bottom: 8rpx;
}

.tips-body {
  font-size: 22rpx;
  color: #85877B;
  line-height: 1.5;
}

.sheet-bottom {
  display: flex;
  justify-content: center;
}

.primary-green-btn {
  width: 100%;
  height: 90rpx;
  background-color: #559E75;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(85, 158, 117, 0.3);
}

.primary-green-btn:active {
  background-color: #3F8054;
}
