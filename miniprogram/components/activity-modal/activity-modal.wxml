<view wx:if="{{visible}}" class="modal-overlay" catchtouchmove="preventProp" bindtap="handleClose">
  <view class="sheet-container" catchtap="preventProp">
    <view class="sheet-header">
      <view class="title-meta">
        <text class="activity-title">{{activity.title}}</text>
        <view class="category-pill">{{activity.category}}</view>
      </view>
      <view class="round-icon-btn" bindtap="handleClose">✕</view>
    </view>

    <view class="illustration-frame">
      <image class="cover-art" src="{{activity.coverImage}}" mode="aspectFill" />
    </view>

    <view class="steps-section">
      <text class="section-badge">极简三步法</text>
      <view class="step-row" wx:for="{{activity.steps}}" wx:key="index">
        <view class="step-number">{{index + 1}}</view>
        <view class="step-text-wrap">
          <text class="step-bold" wx:if="{{item.title}}">{{item.title}}：</text>
          <text class="step-bold" wx:elif="{{item.bold}}">{{item.bold}}：</text>
          <text class="step-desc">{{item.description || item.desc || item}}</text>
        </view>
      </view>
    </view>

    <view class="tips-box" wx:if="{{activity.safetyReminder || activity.tips}}">
      <text class="tips-heading">💡 陪伴互动锦囊</text>
      <text class="tips-body">{{activity.safetyReminder || activity.tips}}</text>
    </view>

    <view class="sheet-bottom">
      <view class="primary-green-btn" catchtap="onFinishTap">
        <text>结束陪伴</text>
      </view>
    </view>
  </view>
</view>
