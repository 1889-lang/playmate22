.history-page {
  min-height: 100vh;
  background-color: #FAF9F2;
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}

.week-calendar-card {
  background-color: #FFFFFF;
  border-radius: 40rpx;
  padding: 36rpx 28rpx;
  border: 1rpx solid #EDF4E9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 32rpx;
}

.calendar-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.calendar-title-box {
  display: flex;
  flex-direction: column;
}

.calendar-month-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #292524;
}

.calendar-sub-text {
  font-size: 22rpx;
  color: #85877B;
  margin-top: 4rpx;
}

.calendar-nav-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-circle-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: #FAF9F2;
  color: #85877B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.current-week-tag {
  background-color: #EDF4E9;
  color: #3F8054;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6rpx;
  text-align: center;
}

.day-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.day-name {
  font-size: 22rpx;
  color: #85877B;
  margin-bottom: 12rpx;
}

.day-badge-box {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-badge {
  width: 72rpx;
  height: 90rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-badge.selected {
  background-color: #2E5A44;
}

.day-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #45483F;
}

.day-badge.selected .day-num {
  color: #FFFFFF;
}

.day-num.today {
  color: #2E5A44;
  font-weight: 800;
}

.dot-indicator {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-top: 6rpx;
}

.green-dot {
  background-color: #559E75;
}

.white-dot {
  background-color: #FFFFFF;
}

.hidden-dot {
  opacity: 0;
}

/* 记录列表 */
.records-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.records-header {
  padding: 8rpx 4rpx;
}

.records-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #45483F;
}

.date-group-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-date-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 8rpx;
}

.green-dot-bullet {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #559E75;
}

.group-date-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #45483F;
}

.group-items-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.handbook-entry-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #EDF4E9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.entry-left-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.entry-activity-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #292524;
}

.entry-duration-meta {
  font-size: 22rpx;
  color: #85877B;
}

.entry-right-thumb {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.thumb-frame {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background-color: #FAF9F2;
  border: 1rpx solid #EDF4E9;
  overflow: hidden;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.entry-chevron {
  color: #A8A29E;
  font-size: 32rpx;
}

.empty-state-card {
  background-color: #FFFFFF;
  border-radius: 36rpx;
  padding: 60rpx 32rpx;
  border: 1rpx solid #EDF4E9;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #45483F;
}

.empty-desc {
  font-size: 22rpx;
  color: #85877B;
}
