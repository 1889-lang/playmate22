/* miniprogram/pages/calendar/calendar.wxss */
.container {
  padding: 24rpx 28rpx 60rpx 28rpx;
  background-color: #FBF9F5;
  min-height: 100vh;
}

.footprint-section {
  display: flex;
  flex-direction: column;
}

.date-header {
  font-size: 28rpx;
  font-weight: 600;
  color: #292524;
  padding: 12rpx 8rpx 20rpx 8rpx;
}

.empty-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  border: 1rpx solid #EDF4E9;
  padding: 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #44403C;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #A8A29E;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  border: 1rpx solid #EDF4E9;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  transition: all 0.2s ease;
}

.record-card:active {
  transform: scale(0.99);
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
  padding-right: 20rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #292524;
}

.badge-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag-badge {
  background-color: #ECFDF5;
  color: #047857;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(16, 185, 129, 0.2);
}

.duration-text {
  font-size: 24rpx;
  color: #78716C;
}

.card-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.thumb-frame {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #FAF9F2;
  border: 1rpx solid #EDF4E9;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.arrow-icon {
  font-size: 36rpx;
  color: #D6D3D1;
  font-weight: 300;
}
