.profile-container {
  min-height: 100vh;
  background-color: #FAF9F2;
  padding: 36rpx 32rpx 120rpx;
  box-sizing: border-box;
}
.warm-card {
  background-color: #FFFFFF;
  border-radius: 40rpx;
  padding: 40rpx 36rpx;
  border: 1rpx solid #EDF4E9;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 32rpx;
}
.baby-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding-bottom: 36rpx;
  border-bottom: 1rpx solid #EDF4E9;
}
.baby-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background-color: #EDF4E9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}
.baby-meta {
  display: flex;
  flex-direction: column;
}
.baby-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #45483F;
}
.baby-subtitle {
  font-size: 24rpx;
  color: #85877B;
  margin-top: 8rpx;
}
.form-list {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.form-row {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.form-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #45483F;
}
.form-field {
  width: 100%;
  height: 92rpx;
  background-color: #FAF9F2;
  border: 1rpx solid #EDF4E9;
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #45483F;
  box-sizing: border-box;
}
.age-selector {
  width: 100%;
  height: 92rpx;
  background-color: #FAF9F2;
  border: 1rpx solid #EDF4E9;
  border-radius: 24rpx;
  padding: 0 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}
.age-highlight {
  font-size: 28rpx;
  font-weight: 700;
  color: #3F8054;
}
.age-placeholder {
  font-size: 26rpx;
  color: #85877B;
}
.arrow {
  color: #85877B;
  font-size: 36rpx;
  font-weight: 300;
}
.support-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.support-icon {
  font-size: 28rpx;
}
.support-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #45483F;
}
.support-tip {
  font-size: 24rpx;
  color: #85877B;
  margin: 12rpx 0 24rpx;
  display: block;
}
.wechat-row {
  background-color: #FAF9F2;
  border: 1rpx solid #EDF4E9;
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.wechat-code {
  font-size: 26rpx;
  color: #45483F;
  font-family: monospace;
  font-weight: 600;
}
.mini-copy-btn {
  height: 60rpx !important;
  line-height: 60rpx !important;
  background-color: #62AD78 !important;
  color: #FFFFFF !important;
  font-size: 24rpx !important;
  border-radius: 16rpx !important;
  padding: 0 28rpx !important;
  margin: 0 !important;
}
.reset-box {
  text-align: center;
  margin-top: 36rpx;
}
.reset-btn {
  font-size: 24rpx;
  color: #85877B;
  display: inline-block;
  padding: 12rpx 24rpx;
}
.age-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(30, 27, 25, 0.55);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}
.age-sheet {
  width: 100%;
  max-width: 650rpx;
  background-color: #FFFFFF;
  border-radius: 44rpx;
  padding: 40rpx 32rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}
.sheet-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #EDF4E9;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #45483F;
}
.sheet-close {
  font-size: 32rpx;
  color: #85877B;
  padding: 8rpx 16rpx;
}
.month-scroll-view {
  flex: 1;
  overflow-y: auto;
  padding-top: 24rpx;
}
.group-block {
  margin-bottom: 32rpx;
}
.group-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #3F8054;
  margin-bottom: 16rpx;
  display: block;
}
.month-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.month-cell {
  height: 76rpx;
  border-radius: 20rpx;
  background-color: rgba(237, 244, 233, 0.6);
  border: 1rpx solid rgba(98, 173, 120, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #45483F;
}
.month-cell.active {
  background-color: #62AD78;
  color: #FFFFFF;
  border-color: #62AD78;
}
