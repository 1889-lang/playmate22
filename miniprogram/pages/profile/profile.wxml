<!-- miniprogram/pages/profile/profile.wxml -->
<view class="container">
  <!-- 头像与宝宝基础资料 -->
  <view class="profile-card">
    <view class="avatar-circle">👶</view>
    <text class="baby-name">小芽芽</text>
    <text class="baby-detail">月龄：7 个月 | 适龄范围：6–8 个月</text>
  </view>

  <!-- 提示板块 -->
  <view class="info-card">
    <text class="info-title">💡 陪伴理念</text>
    <text class="info-desc">每天打开就能找到适合当前月龄的亲子玩法。优先选择家里常见物品，活动不是训练任务，重在温馨亲子互动。</text>
  </view>

  <!-- 功能设置 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onClearData">
      <text class="menu-label">清除本地测试记录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
