.home-container {
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}

.home-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.header-titles {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.app-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #292524;
  line-height: 1.2;
}

.app-subtitle {
  font-size: 26rpx;
  color: #85877B;
}

.mode-pill {
  background-color: #E8F2EC;
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
}

.mode-pill-text {
  font-size: 24rpx;
  color: #2E5A44;
  font-weight: 600;
}

.featured-card {
  background-color: #FFFFFF;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
}

.cover-box {
  width: 100%;
  height: 480rpx;
  background-color: #FAF9F2;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.card-content {
  padding: 32rpx 28rpx 36rpx;
}

.card-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #292524;
  display: block;
  margin-bottom: 14rpx;
}

.card-intro {
  font-size: 28rpx;
  line-height: 1.6;
  color: #57594F;
  display: block;
  margin-bottom: 24rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 32rpx;
}

.tag-pill {
  font-size: 24rpx;
  color: #2E5A44;
  background-color: #E8F2EC;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.start-btn-wrap {
  display: flex;
  justify-content: center;
}

.start-play-btn {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #559E75 !important;
  color: #FFFFFF !important;
  border-radius: 48rpx;
  font-size: 32rpx !important;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 10rpx 24rpx rgba(85, 158, 117, 0.32);
  border: none;
}

.play-icon {
  font-size: 26rpx;
}

.btn-label {
  font-size: 32rpx;
}

.gallery-section {
  margin-top: 12rpx;
}

.gallery-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.gallery-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #292524;
}

.more-link {
  font-size: 26rpx;
  color: #2E5A44;
  font-weight: 600;
}

.gallery-grid {
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
  padding-bottom: 16rpx;
}

.gallery-item {
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.gallery-thumb-box {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #FFFFFF;
  border: 1rpx solid #EDF4E9;
}

.gallery-thumb {
  width: 100%;
  height: 100%;
}

.gallery-item-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #292524;
  text-align: center;
}
