/* miniprogram/pages/index/index.wxss */
.container {
  padding: 24rpx 28rpx 60rpx 28rpx;
  background-color: #FBF9F5;
  min-height: 100vh;
}

.hero-card {
  background-color: #2E5A44;
  color: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(46, 90, 68, 0.15);
}

.baby-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.baby-name {
  font-size: 34rpx;
  font-weight: 700;
}

.baby-age {
  font-size: 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.section-title-bar {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #292524;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  border: 1rpx solid #EDF4E9;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  transition: transform 0.15s ease;
}

.activity-card:active {
  transform: scale(0.99);
}

.card-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-right: 20rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.cat-tag {
  background-color: #ECFDF5;
  color: #047857;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.review-tag {
  background-color: #FFF1F2;
  color: #BE123C;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.duration-tag {
  font-size: 22rpx;
  color: #78716C;
}

.act-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #292524;
}

.act-sub {
  font-size: 24rpx;
  color: #78716C;
}

.card-right {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #FAF9F2;
  border: 1rpx solid #EDF4E9;
}

.cover-thumb {
  width: 100%;
  height: 100%;
}
