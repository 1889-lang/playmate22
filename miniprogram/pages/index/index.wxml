<view class="home-container">
  <view class="home-header">
    <view class="header-titles">
      <text class="app-title">玩伴日历</text>
      <text class="app-subtitle">今天，和宝宝一起发现世界的小美好</text>
    </view>
    <view class="mode-pill" wx:if="{{!profile}}">
      <text class="mode-pill-text">🌱 探索模式</text>
    </view>
  </view>

  <view class="featured-card" wx:if="{{currentActivity}}">
    <view class="cover-box" bindtap="handleSelectActivity" data-id="{{currentActivity.id}}">
      <image class="cover-image" src="{{currentActivity.coverImage}}" mode="aspectFill" />
    </view>

    <view class="card-content">
      <text class="card-title" bindtap="handleSelectActivity" data-id="{{currentActivity.id}}">{{currentActivity.cleanTitle}}</text>
      <text class="card-intro">{{currentActivity.friendlyIntro}}</text>

      <view class="tags-row">
        <view class="tag-pill">{{currentActivity.category}}</view>
        <view class="tag-pill">亲子互动</view>
        <view class="tag-pill">⏱ {{currentActivity.duration}}</view>
      </view>

      <view class="start-btn-wrap">
        <button class="start-play-btn" bindtap="handleStartPlay" data-id="{{currentActivity.id}}">
          <text class="play-icon">▶</text>
          <text class="btn-label">开始陪伴</text>
        </button>
      </view>
    </view>
  </view>

  <view class="gallery-section">
    <view class="gallery-header">
      <text class="gallery-title">今天还想玩什么？</text>
      <text class="more-link" bindtap="goToLibrary">更多玩法 ›</text>
    </view>

    <view class="gallery-grid">
      <block wx:for="{{backupActivities}}" wx:key="id">
        <view class="gallery-item" bindtap="handleSelectActivity" data-id="{{item.id}}">
          <view class="gallery-thumb-box">
            <image class="gallery-thumb" src="{{item.coverImage}}" mode="aspectFill" />
          </view>
          <text class="gallery-item-title">{{item.cleanTitle}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 1. 玩法指引弹窗（截图1） -->
  <activity-modal 
    visible="{{isModalOpen}}" 
    activity="{{selectedActivity}}" 
    bind:close="handleCloseModal"
    bind:finish="handleCompletePlay"
  />

  <!-- 2. 完成陪伴打卡与拍立得一体弹窗（截图2） -->
  <polaroid-modal
    visible="{{isPolaroidOpen}}"
    record="{{currentRecord}}"
    bind:close="handleClosePolaroid"
  />
</view>
