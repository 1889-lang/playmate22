<!-- miniprogram/pages/vault/vault.wxml -->
<view class="container">
  <!-- 滚动横向分类标签 (原生 scroll-view scroll-x) -->
  <scroll-view class="category-scroll" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
    <view class="scroll-track">
      <block wx:for="{{categories}}" wx:key="*this">
        <view 
          class="pill-tag {{selectedCategory === item ? 'active-pill' : ''}}" 
          bindtap="onSelectCategory" 
          data-cat="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 活动列表 -->
  <view class="vault-list">
    <block wx:for="{{filteredActivities}}" wx:key="id">
      <view class="vault-card">
        <view class="vault-info">
          <view class="tag-row">
            <text class="cat-badge">{{item.category}}</text>
            <text class="review-badge" wx:if="{{!item.isReviewed}}">⚠️ 待安全复核</text>
            <text class="age-badge">{{item.ageRange}}</text>
          </view>
          <text class="vault-title">{{item.title}}</text>
          <text class="vault-sub">{{item.subtitle}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
