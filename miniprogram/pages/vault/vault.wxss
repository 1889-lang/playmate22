page {
  background-color: #FAF9F2;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

.vault-container {
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.filter-section {
  margin-bottom: 24rpx;
}

.tag-row {
  width: 100%;
  white-space: nowrap;
  display: block;
  margin-bottom: 16rpx;
}

.filter-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  line-height: 1.4;
  background-color: #FFFFFF;
  color: #4A5568;
  border: 1rpx solid #EAEBE6;
  vertical-align: middle;
}

.filter-tag.active {
  background-color: #4D7C5F;
  color: #FFFFFF;
  border-color: #4D7C5F;
}

.activity-list {
  width: 100%;
}

.activity-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F0EFEA;
}

.card-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background-color: #F5F4EE;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
}

.card-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: #EAF3EC;
  color: #4D7C5F;
}

.card-sub {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.5;
margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.card-duration {
  font-size: 22rpx;
  color: #A0AEC0;
}

.card-link {
  font-size: 24rpx;
  font-weight: 500;
  color: #2E5A44;
}
