page {
  background-color: #FAF9F2;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

.vault-container {
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 顶部分段控件 */
.segment-wrapper {
  margin-bottom: 24rpx;
  display: flex;
  justify-content: center;
}

.segment-bar {
  display: flex;
  background-color: #EDF4E9;
  border-radius: 40rpx;
  padding: 6rpx;
  width: 100%;
  max-width: 520rpx;
  box-sizing: border-box;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #555A4E;
  border-radius: 34rpx;
  transition: all 0.2s ease;
}

.segment-item.active {
  background-color: #4D7C5F;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(77, 124, 95, 0.2);
}

.filter-section {
  margin-bottom: 24rpx;
}

.tag-row {
  width: 100%;
  white-space: nowrap;
  display: block;
  margin-bottom: 16rpx;
}

.filter-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  line-height: 1.4;
  background-color: #FFFFFF;
  color: #4A5568;
  border: 1rpx solid #EAEBE6;
  vertical-align: middle;
}

.filter-tag.active {
  background-color: #4D7C5F;
  color: #FFFFFF;
  border-color: #4D7C5F;
}

.activity-list {
  width: 100%;
}

.activity-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F0EFEA;
}

.card-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background-color: #F5F4EE;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
}

.card-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: #EAF3EC;
  color: #4D7C5F;
}

.card-sub {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.5;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.card-duration {
  font-size: 22rpx;
  color: #A0AEC0;
}

.card-link {
  font-size: 24rpx;
  font-weight: 500;
  color: #2E5A44;
}

/* 精选主题列表样式 */
.theme-list {
  width: 100%;
}

.theme-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F0EFEA;
  align-items: center;
}

.theme-card:active {
  transform: scale(0.99);
  background-color: #FDFCF7;
}

.theme-cover {
  width: 190rpx;
  height: 190rpx;
  border-radius: 20rpx;
  background-color: #F5F4EE;
  flex-shrink: 0;
}

.theme-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 190rpx;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.theme-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.theme-age {
  font-size: 20rpx;
  font-weight: 600;
  color: #3F8054;
  background: #EAF3EC;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.theme-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #4D7C5F;
  background: #EDF4E9;
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
}

.theme-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3748;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-sub {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.4;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.theme-foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 12rpx;
}

.theme-explore {
  font-size: 26rpx;
  font-weight: 600;
  color: #2E5A44;
}
