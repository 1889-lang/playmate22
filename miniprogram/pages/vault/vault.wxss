page {
  background-color: #FAF9F2;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

.vault-container {
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 顶部：精选活动主题横向滚动 */
.theme-section {
  margin-bottom: 24rpx;
}

.theme-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.title-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3748;
}

.section-sub {
  font-size: 22rpx;
  color: #A0AEC0;
}

.reset-theme-btn {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background-color: #EDF4E9;
  border: 1rpx solid rgba(98, 173, 120, 0.3);
}

.reset-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #3F8054;
}

.theme-scroll-row {
  width: 100%;
  white-space: nowrap;
  display: flex;
  box-sizing: border-box;
}

.theme-card-item {
  display: inline-block;
  vertical-align: top;
  width: 320rpx;
  height: 200rpx;
  margin-right: 20rpx;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border: 4rpx solid transparent;
  transition: all 0.2s ease-in-out;
  box-sizing: border-box;
  flex-shrink: 0;
}

.theme-card-item:last-child {
  margin-right: 8rpx;
}

.theme-card-item.active {
  border-color: #4D7C5F;
  box-shadow: 0 8rpx 24rpx rgba(77, 124, 95, 0.3);
  transform: translateY(-2rpx);
}

.theme-card-bg {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.theme-card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.65) 100%);
}

.theme-card-content {
  position: relative;
  z-index: 2;
  padding: 18rpx 20rpx;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  white-space: normal;
}

.theme-card-badge {
  align-self: flex-start;
  font-size: 18rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.3);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.theme-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
  margin-top: 4rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}

.theme-card-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.2;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.theme-card-foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.theme-card-count {
  font-size: 20rpx;
  font-weight: 600;
  color: #FAF9F2;
  background: rgba(0, 0, 0, 0.3);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

/* 中间：筛选器区 */
.filter-section {
  margin-bottom: 24rpx;
}

.tag-row {
  width: 100%;
  white-space: nowrap;
  display: block;
  margin-bottom: 16rpx;
}

.filter-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  line-height: 1.4;
  background-color: #FFFFFF;
  color: #4A5568;
  border: 1rpx solid #EAEBE6;
  vertical-align: middle;
}

.filter-tag.active {
  background-color: #4D7C5F;
  color: #FFFFFF;
  border-color: #4D7C5F;
}

/* 下方：活动卡片列表 */
.activity-list {
  width: 100%;
}

.activity-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F0EFEA;
}

.activity-card:active {
  transform: scale(0.99);
  background-color: #FDFCF7;
}

.card-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background-color: #F5F4EE;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
}

.card-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: #EAF3EC;
  color: #4D7C5F;
}

.card-sub {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.5;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.card-duration {
  font-size: 22rpx;
  color: #A0AEC0;
}

.card-link {
  font-size: 24rpx;
  font-weight: 500;
  color: #2E5A44;
}
