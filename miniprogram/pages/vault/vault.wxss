/* miniprogram/pages/vault/vault.wxss */
.container {
  padding: 24rpx 0 60rpx 0;
  background-color: #FBF9F5;
  min-height: 100vh;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.scroll-track {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 32rpx;
}

.pill-tag {
  flex-shrink: 0;
  white-space: nowrap;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background-color: #FFFFFF;
  color: #57534E;
  font-size: 24rpx;
  border: 1rpx solid #E7E5E4;
}

.active-pill {
  background-color: #2E5A44;
  color: #FFFFFF;
  border-color: #2E5A44;
  font-weight: 600;
}

.vault-list {
  padding: 12rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.vault-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  border: 1rpx solid #EDF4E9;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vault-card:active {
  transform: scale(0.99);
}

.vault-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  padding-right: 16rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.cat-badge {
  background-color: #ECFDF5;
  color: #047857;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.review-badge {
  background-color: #FFF1F2;
  color: #BE123C;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.age-badge {
  font-size: 20rpx;
  color: #78716C;
}

.vault-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #292524;
}

.vault-sub {
  font-size: 24rpx;
  color: #78716C;
}

.arrow-wrap {
  padding-left: 12rpx;
}

.arrow {
  font-size: 36rpx;
  color: #D6D3D1;
  font-weight: 300;
}
