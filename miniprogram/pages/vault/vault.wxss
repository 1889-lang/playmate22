.vault-page {
  min-height: 100vh;
  background-color: #FAF9F2;
  padding: 24rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.filters-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.horizontal-scroll {
  width: 100%;
  white-space: nowrap;
}

.scroll-inner {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 6rpx 4rpx;
}

.filter-pill {
  flex-shrink: 0;
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 600;
  background-color: #FFFFFF;
  color: #45483F;
  border: 1rpx solid #EDF4E9;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.02);
}

.age-pill.active {
  background-color: #62AD78;
  color: #FFFFFF;
  border-color: #62AD78;
}

.cat-pill.active {
  background-color: #3F8054;
  color: #FFFFFF;
  border-color: #3F8054;
}

.vault-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.vault-activity-card {
  background-color: #FFFFFF;
  border-radius: 36rpx;
  padding: 24rpx;
  border: 1rpx solid #EDF4E9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.card-thumb-frame {
  width: 150rpx;
  height: 150rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #FAF9F2;
  border: 1rpx solid #EDF4E9;
  flex-shrink: 0;
}

.card-thumb-image {
  width: 100%;
  height: 100%;
}

.card-info-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.card-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #292524;
}

.card-tag-badge {
  font-size: 20rpx;
  color: #2E5A44;
  background-color: #E8F2EC;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.card-subtitle-desc {
  font-size: 24rpx;
  color: #85877B;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4rpx;
}

.card-duration-text {
  font-size: 22rpx;
  color: #A8A29E;
}

.card-action-text {
  font-size: 22rpx;
  color: #2E5A44;
  font-weight: 700;
}

.empty-box {
  background-color: #FFFFFF;
  border-radius: 36rpx;
  padding: 80rpx
32rpx;
  border: 1rpx solid #EDF4E9;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-msg {
  font-size: 26rpx;
  color: #85877B;
  font-weight: 600;
}
