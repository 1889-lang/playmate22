  const handleRecordSubmit = (data: {
    activityId: string;
    activityTitle: string;
    category: string;
    durationMinutes: number;
    status: 'completed' | 'interrupted';
    babyReaction: BabyReaction;
    note: string;
  }) => {
    // 幂等防重：检查是否 3 秒内在同一活动重复打卡
    const isDuplicate = records.some(
      r => r.activityId === data.activityId && 
           r.date === getLocalDateString() && 
           Date.now() - Number(r.id) < 3000
    );
    if (isDuplicate) return;

    const newRecord: PlayRecord = {
      id: Date.now().toString(),
      activityId: data.activityId,
      activityTitle: data.activityTitle,
      category: data.category,
      date: getLocalDateString(),
      durationMinutes: data.durationMinutes,
      status: data.status,
      babyReaction: data.babyReaction,
      note: data.note,
    };

    const updated = [newRecord, ...records];
    setRecords(updated);
    const ok = safeStorage.set('playmate_play_records', updated);
    if (!ok) {
