二、 升级日期与本地计算工具（src/utils/date.ts）
增加根据出生日期计算当前宝宝总月龄的纯数值函数，杜绝任何 UTC 漂移：

TypeScript


/**
 * 获取本地 YYYY-MM-DD 字符串（杜绝东八区晚上8点后时间漂移）
 */
export const getLocalDateString = (d: Date = new Date()): string => {
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

/**
 * 计算宝宝当前的绝对自然月龄（用于精准过滤适龄活动）
 */
export const getBabyAgeMonths = (birthDateStr: string): number => {
  if (!birthDateStr) return 7;
  const birth = new Date(birthDateStr);
  const now = new Date();
  if (isNaN(birth.getTime()) || birth > now) return 0;
  
  let months = (now.getFullYear() - birth.getFullYear()) * 12 + (now.getMonth() - birth.getMonth());
  if (now.getDate() < birth.getDate()) {
    months -= 1;
  }
  return Math.max(0, months);
};

/**
 * 界面友好月龄展示
 */
export const calculateBabyAge = (birthDateStr: string): string => {
  if (!birthDateStr) return '7个月';
  const birth = new Date(birthDateStr);
  const now = new Date();
  
  if (isNaN(birth.getTime()) || birth > now) return '新生儿';

  let months = (now.getFullYear() - birth.getFullYear()) * 12 + (now.getMonth() - birth.getMonth());
  let days = now.getDate() - birth.getDate();

  if (days < 0) {
    months -= 1;
    const prevMonthDays = new Date(now.getFullYear(), now.getMonth(), 0).getDate();
    days += prevMonthDays;
  }

  if (months <= 0) {
    return `${Math.max(1, days)}天`;
  }
  if (days === 0) {
    return `${months}个月`;
  }
  return `${months}个月零${days}天`;
};
