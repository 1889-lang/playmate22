  const [babyProfile, setBabyProfile] = useState<BabyProfile>(() => 
    safeStorage.get('playmate_baby_profile', {
      name: '',
      birthDate: '',
      isInitialized: false,
    })
  );
  const [showProfileModal, setShowProfileModal] = useState<boolean>(() => !babyProfile.isInitialized);

