  const safeActivities = useMemo(() => {
    const list = allActivities.filter(a => a.isVerified && currentMonths >= a.minAgeMonths && currentMonths <= a.maxAgeMonths);
    return list.length > 0 ? list : allActivities.filter(a => a.isVerified);
