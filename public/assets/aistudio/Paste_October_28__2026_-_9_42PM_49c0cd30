import React, { useState, useRef } from 'react';
import { Activity, BabyReaction } from '../types';
import { getLocalDateString } from '../utils/date';
import { Download, Sparkles, X, Heart, Clock, Award } from 'lucide-react';

interface PlayFeedbackModalProps {
  activity: Activity;
  durationMinutes: number;
  status: 'completed' | 'interrupted';
  onClose: () => void;
  onSubmit: (data: {
    activityId: string;
    activityTitle: string;
    category: string;
    durationMinutes: number;
    status: 'completed' | 'interrupted';
    babyReaction: BabyReaction;
    note: string;
  }) => void;
}

export const PlayFeedbackModal: React.FC<PlayFeedbackModalProps> = ({
  activity,
  durationMinutes,
  status,
  onClose,
  onSubmit,
}) => {
  const [babyReaction, setBabyReaction] = useState<BabyReaction>('happy');
  const [note, setNote] = useState('');
  const [isSubmitting, setIsSubmitting] = useState(false);
  const canvasRef = useRef<HTMLCanvasElement null |>(null);

  const handleDownloadPoster = () => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // 绘制 600x840 原生高质相纸
    canvas.width = 600;
    canvas.height = 840;

    // 相纸底色
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(0, 0, 600, 840);

    // 装饰手帐边框
    ctx.strokeStyle = '#FAF7F2';
    ctx.lineWidth = 16;
    ctx.strokeRect(16, 16, 568, 808);

    // 顶部日期（使用本地日期）
    const localToday = getLocalDateString();
    ctx.fillStyle = '#858078';
    ctx.font = 'bold 20px sans-serif';
    ctx.fillText(`🐾 玩伴手帐 ｜ ${localToday}`, 50, 70);

    // 绘制照片内框
    ctx.fillStyle = '#FAF7F2';
    ctx.fillRect(50, 100, 500, 480);
    ctx.strokeStyle = '#EFE5D8';
    ctx.lineWidth = 2;
    ctx.strokeRect(50, 100, 500, 480);

    // 绘制活动主题与表情
    ctx.fillStyle = '#45433F';
    ctx.font = 'bold 36px sans-serif';
    ctx.fillText(activity.title, 80, 240);

    ctx.fillStyle = '#F28C45';
    ctx.font = 'bold 24px sans-serif';
    ctx.fillText(`分类: ${activity.category}  |  陪伴: ${durationMinutes} 分钟`, 80, 290);

    ctx.fillStyle = '#858078';
    ctx.font = '22px sans-serif';
    ctx.fillText(status === 'completed' ? '✨ 顺利完成高质量陪伴' : '🌿 虽提前休息，但陪伴很温暖', 80, 340);

    // 宝宝反应大表情
    ctx.font = '72px sans-serif';
    const emoji = babyReaction === 'happy' ? '😍' : babyReaction === 'calm' ? '😊' : '🥱';
    ctx.fillText(emoji, 80, 450);

    // 底部随手记
    if (note.trim()) {
      ctx.fillStyle = '#6B665F';
      ctx.font = 'italic 22px sans-serif';
      ctx.fillText(`“${note.trim().slice(0, 20)}...”`, 50, 640);
    }

    // 底部私域裂变文案
    ctx.fillStyle = '#B8860B';
    ctx.font = 'bold 18px sans-serif';
    ctx.fillText('扫码进「21天高质量陪伴营」· 与千位妈妈共成长', 50, 760);

    // 生成本地相册下载，文件名使用本地日期，彻底杜绝 UTC 漂移
    const link = document.createElement('a');
    link.download = `玩伴日历-${localToday}.png`;
    link.href = canvas.toDataURL('image/png');
    link.click();
  };

  const handleSubmit = () => {
    if (isSubmitting) return; // 防连击
    setIsSubmitting(true);
    onSubmit({
      activityId: activity.id,
      activityTitle: activity.title,
      category: activity.category,
      durationMinutes,
      status,
      babyReaction,
      note: note.trim(),
    });
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4">
      <div className="w-full max-w-sm bg-white rounded-3xl p-5 border border-[#F1EAE0] shadow-2xl space-y-4 animate-in zoom-in-95 duration-200">
        <div className="flex items-center justify-between border-b border-[#F1EAE0] pb-3">
          <div className="flex items-center gap-1.5 font-bold text-sm text-[#45433F]">
            <Award className="w-4 h-4 text-[#F28C45]"/> 陪伴打卡记
          </div>
          <button onClick={onClose} className="text-[#858078] hover:text-[#45433F] cursor-pointer">
            <X className="w-4 h-4"/>
          </button>
        </div>

        <div className="text-center space-y-1">
          <span className="text-xs text-[#858078]">
            {status === 'completed' ? '✨ 陪伴圆满完成' : '🌿 虽提前停止，但陪伴同样珍贵'}
          </span>
          <h4 className="text-base font-bold text-[#45433F]">{activity.title}</h4>
          <span className="text-xs font-mono font-bold text-[#F28C45]">{durationMinutes} 分钟</span>
        </div>

        {/* 宝宝反应三选一 */}
        <div className="space-y-1.5">
          <label className="text-xs font-bold text-[#45433F]">宝宝此时的状态：</label>
          <div className="grid grid-cols-3 gap-2">
            {[
              { key: 'happy', label: '很开心', emoji: '😍' },
              { key: 'calm', label: '平静专注', emoji: '😊' },
              { key: 'tired', label: '有点疲劳', emoji: '🥱' },
            ].map((r) => (
              <button
                key={r.key}
                type="button"
                onClick={() => setBabyReaction(r.key as BabyReaction)}
                className={`py-2 rounded-2xl border text-center transition-all cursor-pointer ${
                  babyReaction === r.key
                    ? 'border-[#F28C45] bg-[#FFF5EE] shadow-xs'
                    : 'border-[#F1EAE0] bg-[#FAF7F2]'
                }`}
              >
                <div className="text-xl">{r.emoji}</div>
                <div className="text-[11px] font-bold text-[#45433F] mt-0.5">{r.label}</div>
              </button>
            ))}
          </div>
        </div>

        {/* 随手记短文本 */}
        <div className="space-y-1">
          <label className="text-xs font-bold text-[#45433F]">写一句手帐小记（选填）：</label>
          <input
            type="text"
            placeholder="例如：今天小宝抓着小球笑得好开心~"
            value={note}
            maxLength={30}
            onChange={(e) => setNote(e.target.value)}
            className="w-full h-10 px-3 rounded-xl bg-[#FAF7F2] border border-[#F1EAE0] text-xs text-[#45433F] focus:outline-none focus:border-[#F28C45]"
          />
        </div>

        {/* 隐藏 Canvas 用于渲染 */}
        <canvas ref={canvasRef} className="hidden" />

        {/* 按钮组 */}
        <div className="pt-2 space-y-2">
          <button
            onClick={handleDownloadPoster}
            className="w-full h-10 rounded-full bg-[#FAF7F2] hover:bg-[#F5EFE6] text-[#45433F] font-bold text-xs flex items-center justify-center gap-1.5 border border-[#F1EAE0] cursor-pointer"
          >
            <Download className="w-3.5 h-3.5 text-[#F28C45]"/> 保存拍立得相纸到相册
          </button>

          <button
            onClick={handleSubmit}
            disabled={isSubmitting}
            className="w-full h-11 rounded-full bg-gradient-to-r from-[#F28C45] to-[#E5762F] text-white font-bold text-sm shadow-md shadow-[#F28C45]/30 hover:opacity-95 cursor-pointer disabled:opacity-50"
          >
            {isSubmitting ? '保存中...' : '沉淀到成长足迹'}
          </button>
        </div>
      </div>
    </div>
  );
};
