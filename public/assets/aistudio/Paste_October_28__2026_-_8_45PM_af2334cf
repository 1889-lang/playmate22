import React, { useState } from 'react';
import { Activity } from '../types';
import { Lock, Sparkles, Clock, Box, Stethoscope, ChevronRight } from 'lucide-react';

interface LibraryViewProps {
  activities: Activity[];
  isVip: boolean;
  onOpenDetail: (activity: Activity) => void;
  onOpenVipModal: () => void;
}

export const LibraryView: React.FC<LibraryViewProps> = ({
  activities,
  isVip,
  onOpenDetail,
  onOpenVipModal,
}) => {
  const [selectedCategory, setSelectedCategory] = useState<string>('全部');
  const categories = ['全部', '感官认知', '大运动', '精细动作', '语言交流'];

  // 人为设置部分进阶玩法为 VIP 专享
  const isVipActivity = (activity: Activity) => {
    return activity.title.includes('大动作') || activity.title.includes('探索') || activity.category === '语言交流';
  };

  const filtered = selectedCategory === '全部'
    ? activities
    : activities.filter(a => a.category === selectedCategory);

  return (
    <div className="space-y-5 animate-in fade-in duration-300">
      {/* 分类过滤器 */}
      <div className="flex gap-2 overflow-x-auto pb-1 no-scrollbar">
        {categories.map(cat => (
          <button
            key={cat}
            onClick={() => setSelectedCategory(cat)}
            className={`px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap transition-all cursor-pointer ${
              selectedCategory === cat
                ? 'bg-[#F28C45] text-white shadow-xs'
                : 'bg-white text-[#858078] border border-[#F1EAE0] hover:border-[#E8B58D]/40'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      {/* 活动列表 */}
      <div className="space-y-3">
        {filtered.map(act => {
          const locked = isVipActivity(act) && !isVip;

          return (
            <div
              key={act.id}
              onClick={() => {
                if (locked) {
                  onOpenVipModal();
                } else {
                  onOpenDetail(act);
                }
              }}
              className="p-4 bg-white rounded-3xl border border-[#F1EAE0] shadow-xs hover:border-[#E8B58D]/40 transition-all cursor-pointer space-y-3 relative overflow-hidden group"
            >
              <div className="flex items-start justify-between">
                <div className="space-y-1">
                  <div className="flex items-center gap-2">
                    <span className="px-2 py-0.5 rounded-md text-[10px] font-bold bg-[#FAF7F2] text-[#B86834] border border-[#E8B58D]/20">
                      {act.category}
                    </span>
                    <h4 className="text-sm font-bold text-[#45433F] group-hover:text-[#F28C45] transition-colors">
                      {act.title}
                    </h4>
                  </div>
                  <div className="flex items-center gap-3 text-xs text-[#858078]">
                    <span className="flex items-center gap-1"><Clock className="w-3.5 h-3.5 text-[#F28C45]"/> {act.duration}</span>
                    <span className="flex items-center gap-1"><Box className="w-3.5 h-3.5 text-[#A8B9A0]"/> {act.materials}</span>
                  </div>
                </div>

                {/* 锁头或解锁状态标签 */}
                {isVipActivity(act) && (
                  locked ? (
                    <span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#FFF5EE] text-[#F28C45] border border-[#F28C45]/20 shrink-0">
                      <Lock className="w-3 h-3"/> 👑 VIP 专享
                    </span>
                  ) : (
                    <span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#EBF5ED] text-[#54704B] border border-[#54704B]/20 shrink-0">
                      <Sparkles className="w-3 h-3"/> ✨ VIP 已解锁
                    </span>
                  )
                )}
              </div>

              {/* VIP 专享特权展开：儿科专家锦囊（已开通 VIP 独享） */}
              {isVip && (
                <div className="p-2.5 rounded-2xl bg-[#FFF9F3] border border-[#E8B58D]/30 flex items-start gap-2">
                  <Stethoscope className="w-4 h-4 text-[#F28C45] shrink-0 mt-0.5"/>
                  <p className="text-[11px] text-[#858078] leading-relaxed">
                    <strong className="text-[#45433F]">专家脑发育机理：</strong> 该动作重点刺激宝宝本体觉与前庭平衡，有助于未来专注力与情绪稳定沉淀。
                  </p>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
};
