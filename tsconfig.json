{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/miniprogram-api-typings"
    ]
  },
  "include": [
    "./miniprogram/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}